# Alpaca — https://app.alpaca.markets/paper/dashboard/overview for paper keys
ALPACA_API_KEY=your-paper-api-key
ALPACA_SECRET_KEY=your-paper-secret-key
# Paper trading by default. Live endpoint is https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Append-only audit log of executed trades (JSON Lines)
TRADE_LOG_PATH=./trades.jsonl
