# Alpaca — https://app.alpaca.markets/paper/dashboard/overview for paper keys
ALPACA_API_KEY=your-paper-api-key
ALPACA_SECRET_KEY=your-paper-secret-key
# Paper trading by default. Live endpoint is https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Append-only audit log of executed trades (JSON Lines)
TRADE_LOG_PATH=./trades.jsonl

# Never let new BUY orders (combined) spend more than this fraction of actual
# cash -- a cushion against price drift/slippage between computing an order
# and it filling. Doesn't affect sells or change your target weights, only
# how much of a fresh buy gets deployed in one sync.
CASH_BUFFER_PCT=0.95
